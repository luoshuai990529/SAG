# Copy to .env.fnos and replace this value with: openssl rand -hex 32
SAG_SECRET_KEY=replace-with-a-strong-random-secret-of-at-least-32-bytes

# Optional model-provider settings. The application can start without keys,
# but document extraction and question answering require a configured model.
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.302ai.cn/v1
SAG_LLM_API_KEY=
SAG_LLM_MODEL=qwen3.6-flash
SAG_EMBEDDING_MODEL=bge-large-en-v1.5
SAG_EMBEDDING_BASE_URL=https://api.302ai.cn/v1
SAG_EMBEDDING_API_KEY=

# Optional document parser settings.
SAG_DOCUMENT_PARSER=auto
SAG_MINERU_BASE_URL=https://api.302ai.cn
SAG_MINERU_API_KEY=
SAG_MINERU_VERSION=2.5

# Optional web behavior.
NEXT_PUBLIC_ENABLE_WINDOW_SCALING=true
