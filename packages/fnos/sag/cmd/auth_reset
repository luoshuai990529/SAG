#!/bin/bash

set -eu

log_error() {
    printf '%s\n' "$1" >> "${TRIM_TEMP_LOGFILE}"
}

umask 077

if [ "$#" -ne 1 ] || [ "$1" != "--confirm-local-reset" ]; then
    log_error "SAG auth recovery requires the explicit --confirm-local-reset option."
    exit 2
fi

canonical_dir() {
    (cd -P -- "$1" 2>/dev/null && pwd -P)
}

normalize_trailing_slashes() {
    normalized="$1"
    while [ "${normalized}" != "/" ] && [ "${normalized%/}" != "${normalized}" ]; do
        normalized="${normalized%/}"
    done
    printf '%s\n' "${normalized}"
}

validate_owned_canonical_dir() {
    candidate="$1"
    label="$2"
    case "${candidate}" in
        /*) ;;
        *)
            log_error "SAG auth recovery rejected unsafe ${label}: path is not absolute."
            return 1
            ;;
    esac
    if [ ! -d "${candidate}" ] || [ -L "${candidate}" ] || [ ! -O "${candidate}" ]; then
        log_error "SAG auth recovery rejected unsafe ${label}; verify it is an owned real directory."
        return 1
    fi
    resolved="$(canonical_dir "${candidate}")" || {
        log_error "SAG auth recovery could not resolve ${label}."
        return 1
    }
    if [ "${resolved}" != "${candidate}" ]; then
        log_error "SAG auth recovery rejected unsafe noncanonical ${label}."
        return 1
    fi
}

valid_hex_secret() {
    value="$1"
    case "${value}" in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    [ "${#value}" -eq 64 ]
}

generate_secret() {
    generated="$(openssl rand -hex 32)" || return 1
    valid_hex_secret "${generated}" || return 1
    printf '%s\n' "${generated}"
}

pkgvar_dir="$(normalize_trailing_slashes "${TRIM_PKGVAR}")"
pkgetc_dir="$(normalize_trailing_slashes "${TRIM_PKGETC}")"
data_dir="${pkgvar_dir}/data"
secret_file="${pkgetc_dir}/sag.env"
compose_file="${TRIM_APPDEST}/docker/docker-compose.yaml"

compose_sag() {
    docker compose --project-name sag -f "${compose_file}" "$@"
}

validate_owned_canonical_dir "${pkgvar_dir}" "package variable directory" || exit 1
validate_owned_canonical_dir "${pkgetc_dir}" "package configuration directory" || exit 1
validate_owned_canonical_dir "${data_dir}" "active data directory" || exit 1

if [ ! -f "${secret_file}" ] || [ -L "${secret_file}" ] || [ ! -O "${secret_file}" ]; then
    log_error "SAG auth recovery requires an owned regular sag.env."
    exit 1
fi
if ! chmod 600 "${secret_file}"; then
    log_error "SAG auth recovery could not protect sag.env."
    exit 1
fi

session_secret=""
bootstrap_secret=""
line_count=0
while IFS= read -r secret_line || [ -n "${secret_line}" ]; do
    line_count=$((line_count + 1))
    case "${line_count}:${secret_line}" in
        1:SAG_SECRET_KEY=*)
            session_secret="${secret_line#SAG_SECRET_KEY=}"
            ;;
        2:SAG_AUTH_BOOTSTRAP_TOKEN=*)
            bootstrap_secret="${secret_line#SAG_AUTH_BOOTSTRAP_TOKEN=}"
            ;;
        *)
            log_error "SAG auth recovery found an invalid sag.env; refusing to overwrite it."
            exit 1
            ;;
    esac
done < "${secret_file}"

if ! valid_hex_secret "${session_secret}" ||
    ! valid_hex_secret "${bootstrap_secret}" ||
    [ "${session_secret}" = "${bootstrap_secret}" ]; then
    log_error "SAG auth recovery found invalid auth secrets; refusing to overwrite them."
    exit 1
fi

require_project_stopped() {
    container_ids="$(compose_sag ps -aq 2>> "${TRIM_TEMP_LOGFILE}")" || {
        log_error "SAG auth recovery could not enumerate every project container."
        return 1
    }
    unsafe=0
    for container_id in ${container_ids}; do
        container_state=""
        if ! container_state="$(docker inspect --format '{{.State.Status}}' "${container_id}" 2>> "${TRIM_TEMP_LOGFILE}")"; then
            log_error "SAG auth recovery could not inspect a project container; refusing to continue."
            unsafe=1
            continue
        fi
        case "${container_state}" in
            created|exited) ;;
            *)
                log_error "SAG auth recovery found a project container that is not definitively stopped."
                unsafe=1
                ;;
        esac
    done
    [ "${unsafe}" -eq 0 ]
}

require_project_stopped || exit 1

new_bootstrap="$(generate_secret)" || {
    log_error "SAG auth recovery could not generate a new bootstrap credential."
    exit 1
}
if [ "${new_bootstrap}" = "${session_secret}" ] || [ "${new_bootstrap}" = "${bootstrap_secret}" ]; then
    log_error "SAG auth recovery generated a duplicate credential; retry the operation."
    exit 1
fi

# Close the state-check race as far as the fnOS callback interface permits.
# Everything before this second check is read-only or in-memory.
require_project_stopped || exit 1

secret_temp="${secret_file}.reset.$$"
trap 'rm -f -- "${secret_temp}"' EXIT HUP INT TERM
if ! printf 'SAG_SECRET_KEY=%s\nSAG_AUTH_BOOTSTRAP_TOKEN=%s\n' \
    "${session_secret}" "${new_bootstrap}" > "${secret_temp}"; then
    log_error "SAG auth recovery could not stage the new protected credential."
    exit 1
fi
if ! chmod 600 "${secret_temp}"; then
    log_error "SAG auth recovery could not protect the staged credential."
    exit 1
fi

if ! mv -- "${secret_temp}" "${secret_file}"; then
    log_error "SAG auth recovery could not atomically publish the rotated credential; the database was not changed."
    exit 1
fi

# The active path now contains only the new bootstrap. Durably sync both the
# file and its rename before starting the database helper; the app stays stopped
# throughout, and a retry publishes yet another token regardless of DB state.
if ! compose_sag --profile lifecycle run --rm --no-deps -T \
    -e SAG_LIFECYCLE_ACTION=auth-fsync lifecycle-auth-fsync /opt/sag-lifecycle.py \
    >> "${TRIM_TEMP_LOGFILE}" 2>&1; then
    log_error "SAG auth recovery could not durably sync the rotated credential; the database reset was not started. Keep the app stopped and retry."
    exit 1
fi

if ! compose_sag --profile lifecycle run --rm --no-deps -T \
    -e SAG_LIFECYCLE_ACTION=auth-reset lifecycle-auth-reset /opt/sag-lifecycle.py \
    >> "${TRIM_TEMP_LOGFILE}" 2>&1; then
    log_error "SAG auth recovery database helper failed; its commit state is unknown. Keep the app stopped and rerun local reset before any startup."
    exit 1
fi

trap - EXIT HUP INT TERM
exit 0
