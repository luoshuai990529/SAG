#!/bin/bash

set -eu

log_error() {
    printf '%s\n' "$1" >> "${TRIM_TEMP_LOGFILE}"
}

umask 077

canonical_dir() {
    (cd -P -- "$1" 2>/dev/null && pwd -P)
}

normalize_trailing_slashes() {
    normalized="$1"
    while [ "${normalized}" != "/" ] && [ "${normalized%/}" != "${normalized}" ]; do
        normalized="${normalized%/}"
    done
    printf '%s\n' "${normalized}"
}

validate_owned_canonical_dir() {
    candidate="$1"
    label="$2"
    case "${candidate}" in
        /*) ;;
        *)
            log_error "SAG installation rejected unsafe ${label}: path is not absolute."
            return 1
            ;;
    esac
    if [ ! -d "${candidate}" ] || [ -L "${candidate}" ] || [ ! -O "${candidate}" ]; then
        log_error "SAG installation rejected unsafe ${label}; verify it is an owned real directory."
        return 1
    fi
    resolved="$(canonical_dir "${candidate}")" || {
        log_error "SAG installation could not resolve ${label}; verify callback identity and execute permission on the full ancestor chain."
        return 1
    }
    if [ "${resolved}" != "${candidate}" ]; then
        log_error "SAG installation rejected unsafe noncanonical ${label}."
        return 1
    fi
}

pkgvar_dir="$(normalize_trailing_slashes "${TRIM_PKGVAR}")"
pkgetc_dir="$(normalize_trailing_slashes "${TRIM_PKGETC}")"
data_dir="${pkgvar_dir}/data"
backup_dir="${pkgvar_dir}/backup"

validate_owned_canonical_dir "${pkgvar_dir}" "package variable directory" || exit 1
validate_owned_canonical_dir "${pkgetc_dir}" "package configuration directory" || exit 1

for private_child in "${data_dir}" "${backup_dir}"; do
    if [ "${private_child}" = "${data_dir}" ]; then
        private_label="active data directory"
    else
        private_label="backup directory"
    fi
    if [ -L "${private_child}" ] || [ -e "${private_child}" ]; then
        validate_owned_canonical_dir "${private_child}" "${private_label}" || exit 1
    fi
done

if ! chmod 700 "${pkgvar_dir}" "${pkgetc_dir}"; then
    log_error "SAG installation could not protect its private parents."
    exit 1
fi
for private_child in "${data_dir}" "${backup_dir}"; do
    if [ "${private_child}" = "${data_dir}" ]; then
        private_label="active data directory"
    else
        private_label="backup directory"
    fi
    if [ ! -e "${private_child}" ] && ! mkdir -- "${private_child}"; then
        log_error "SAG installation could not create its private directories."
        exit 1
    fi
    validate_owned_canonical_dir "${private_child}" "${private_label}" || exit 1
done
if ! chmod 700 "${data_dir}" "${backup_dir}"; then
    log_error "SAG installation could not protect its private directories."
    exit 1
fi

secret_file="${pkgetc_dir}/sag.env"

if [ ! -e "${secret_file}" ]; then
    secret="$(openssl rand -hex 32)" || {
        log_error "SAG installation could not generate its secret key."
        exit 1
    }
    case "${secret}" in
        *[!0-9a-f]*|'')
            log_error "SAG installation generated an invalid secret key."
            exit 1
            ;;
    esac
    if [ "${#secret}" -ne 64 ]; then
        log_error "SAG installation generated an invalid secret key."
        exit 1
    fi

    secret_temp="${secret_file}.tmp.$$"
    trap 'rm -f -- "${secret_temp}"' EXIT HUP INT TERM
    if ! printf 'SAG_SECRET_KEY=%s\n' "${secret}" > "${secret_temp}"; then
        log_error "SAG installation could not write its temporary secret."
        exit 1
    fi
    if ! chmod 600 "${secret_temp}"; then
        log_error "SAG installation could not protect its temporary secret."
        exit 1
    fi
    if ! ln "${secret_temp}" "${secret_file}" 2>/dev/null && [ ! -e "${secret_file}" ]; then
        log_error "SAG installation could not persist its secret key."
        exit 1
    fi
    rm -f -- "${secret_temp}"
    trap - EXIT HUP INT TERM
fi

if [ ! -f "${secret_file}" ]; then
    log_error "SAG requires ${secret_file} to be a regular file."
    exit 1
fi

existing_secret_line="$(cat "${secret_file}")" || {
    log_error "SAG installation could not read its existing secret."
    exit 1
}
case "${existing_secret_line}" in
SAG_SECRET_KEY=*)
    existing_secret="${existing_secret_line#SAG_SECRET_KEY=}"
    ;;
*)
    existing_secret=""
    ;;
esac
case "${existing_secret}" in
    *[!0-9a-f]*|'') valid_existing_secret=false ;;
    *) valid_existing_secret=true ;;
esac
if [ "${valid_existing_secret}" != true ] || [ "${#existing_secret}" -ne 64 ]; then
    log_error "SAG installation found an invalid existing secret; refusing to overwrite it."
    exit 1
fi

chmod 600 "${secret_file}" || {
    log_error "SAG installation could not protect its secret key."
    exit 1
}

exit 0
